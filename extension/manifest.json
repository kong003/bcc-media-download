{
  "manifest_version": 3,
  "name": "BCC Media Downloader",
  "version": "1.0.0",
  "description": "Lädt HLS/M3U8-Streams von app.bcc.media mit frei wählbarer Qualität, mehreren Audiospuren und Zeitausschnitt als MP4 herunter.",
  "key": "",
  "permissions": [
    "webRequest",
    "storage",
    "scripting",
    "tabs",
    "downloads",
    "offscreen"
  ],
  "host_permissions": [
    "https://app.bcc.media/*",
    "https://*.run.app/*",
    "https://*.bcc.media/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BCC Media Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}